<mxfile host="app.diagrams.net" modified="2026-02-11T00:00:00.000Z" agent="5.0" version="22.1.3">
  <diagram id="provider-neo4j-data-model" name="Provider Communities (Neo4j) — Data Model">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="t1" value="Provider Communities (Neo4j) — Data Model" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Provider -->
        <mxCell id="prov" value="Provider&#xa;—&#xa;npi: string (UNIQUE)&#xa;zip3: string?&#xa;geo: string?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- Drug -->
        <mxCell id="drug" value="Drug&#xa;—&#xa;id: string (UNIQUE)&#xa;name: string? (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="260" height="110" as="geometry"/>
        </mxCell>

        <!-- HCPCS -->
        <mxCell id="hcpcs" value="HCPCS&#xa;—&#xa;code: string (UNIQUE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="230" width="260" height="95" as="geometry"/>
        </mxCell>

        <!-- Geo -->
        <mxCell id="geo" value="Geo&#xa;—&#xa;key: string (UNIQUE)&#xa;examples:&#xa;zip3:190&#xa;geo:TX&#xa;zip3:190|geo:TX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- Community -->
        <mxCell id="comm" value="Community&#xa;—&#xa;(run_id, id): UNIQUE&#xa;run_id: string&#xa;id: int&#xa;k: int (top_k)&#xa;thr: float (sim_threshold)&#xa;created_at: timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="300" height="190" as="geometry"/>
        </mxCell>

        <!-- Notes -->
        <mxCell id="note" value="Notes&#xa;• Drug node key is Drug{id} (not Drug{name}).&#xa;• Communities are RUN-SCOPED via run_id.&#xa;• SIMILAR_TO and IN_COMMUNITY are also run-scoped via run_id property.&#xa;• Drug/HCPCS edges are “drivers”; Community/SIMILAR_TO are “derived graph” outputs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="640" height="180" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="PRESCRIBES&#xa;{count?, spend?}" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="prov" target="drug">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="BILLS&#xa;{count?, spend?}" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="prov" target="hcpcs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="IN_GEO" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="prov" target="geo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="IN_COMMUNITY&#xa;{run_id, drift_score, top_peers}" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="prov" target="comm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SIMILAR_TO is Provider->Provider (self-relationship conceptually) -->
        <mxCell id="e5" value="SIMILAR_TO&#xa;{run_id, sim}" style="endArrow=block;html=1;rounded=0;strokeWidth=2;curved=1;" edge="1" parent="1" source="prov" target="prov">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="80" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
