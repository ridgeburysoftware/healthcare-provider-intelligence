<mxfile host="app.diagrams.net">
  <diagram name="Provider Outlier Review - Mathy">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- INPUTS -->
        <mxCell id="in1" value="Provider Unified Metrics&#10;(allowed/service, cost/claim, scalars)"
          style="rounded=1;whiteSpace=wrap;fillColor=#E3F2FD;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="in2" value="Part B HCPCS Rows&#10;(count, allowed, shares)"
          style="rounded=1;whiteSpace=wrap;fillColor=#E3F2FD;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="in3" value="Part D Drug Rows&#10;(claims, cost, shares)"
          style="rounded=1;whiteSpace=wrap;fillColor=#E3F2FD;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- PEER COHORT -->
        <mxCell id="peer" value="Peer Cohort Definition&#10;taxonomy + geo basis&#10;min peer N"
          style="rounded=1;whiteSpace=wrap;fillColor=#FFF3E0;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- PART B DELTA -->
        <mxCell id="pb" value="Part B Delta&#10;z(allowed/service)&#10;share deltas vs peers"
          style="rounded=1;whiteSpace=wrap;fillColor=#FCE4EC;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- PART D DELTA -->
        <mxCell id="pd" value="Part D Delta&#10;z(cost/claim)&#10;top-k cost share delta"
          style="rounded=1;whiteSpace=wrap;fillColor=#FCE4EC;" vertex="1" parent="1">
          <mxGeometry x="580" y="190" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- COMBINE -->
        <mxCell id="combine" value="Combined Score&#10;wB * ΔB  +  wD * ΔD&#10;normalize → rank"
          style="rounded=1;whiteSpace=wrap;fillColor=#E8F5E9;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- CONFIDENCE -->
        <mxCell id="conf" value="Confidence Band&#10;peer N + stability&#10;signal agreement"
          style="rounded=1;whiteSpace=wrap;fillColor=#E1F5FE;" vertex="1" parent="1">
          <mxGeometry x="840" y="230" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- OUTPUT -->
        <mxCell id="out" value="Explainable Output&#10;• icon + score&#10;• peer basis&#10;• drivers (HCPCS + Drugs)&#10;• Neo4j graph context"
          style="rounded=1;whiteSpace=wrap;fillColor=#F3E5F5;" vertex="1" parent="1">
          <mxGeometry x="1120" y="150" width="230" height="120" as="geometry"/>
        </mxCell>

        <!-- EDGES -->
        <mxCell edge="1" parent="1" source="in1" target="peer"/>
        <mxCell edge="1" parent="1" source="in2" target="pb"/>
        <mxCell edge="1" parent="1" source="in3" target="pd"/>

        <mxCell edge="1" parent="1" source="peer" target="pb"/>
        <mxCell edge="1" parent="1" source="peer" target="pd"/>

        <mxCell edge="1" parent="1" source="pb" target="combine"/>
        <mxCell edge="1" parent="1" source="pd" target="combine"/>

        <mxCell edge="1" parent="1" source="combine" target="conf"/>
        <mxCell edge="1" parent="1" source="conf" target="out"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
