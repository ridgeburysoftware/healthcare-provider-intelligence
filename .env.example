# Standalone local setup. Generate an ignored .env with scripts/configure_local.py.
NEO4J_USER=neo4j
NEO4J_PASS=
NEO4J_URI=bolt://127.0.0.1:17687
APP_PORT=8520
LEGACY_PORT=8521
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
# Optional, server-side explanations. No model calls occur until requested.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# To use the original AWS adapter, set AI_PROVIDER=bedrock and configure this model.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
